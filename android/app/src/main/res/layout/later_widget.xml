<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F7F8F2">
    <TextView android:id="@+id/widget_greeting" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="later." android:textSize="20sp" android:textStyle="bold" android:textColor="#303C33" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_upcoming" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:text="Open Later to see what’s coming up" android:textColor="#303C33" android:textSize="14sp" android:gravity="center_vertical" android:maxLines="3" android:ellipsize="end" android:contentDescription="Open upcoming reminders" />
    <Button android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="48dp"
        android:text="+ Add to Later" android:textColor="#FFFFFF" android:backgroundTint="#303C33" />
</LinearLayout>
