{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "later-voice-token",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ratelimits": [
    {"name": "REQUEST_LIMIT", "namespace_id": "1041101", "simple": {"limit": 20, "period": 60}},
    {"name": "TOKEN_LIMIT", "namespace_id": "1041102", "simple": {"limit": 3, "period": 60}}
  ],
  "observability": {"enabled": false}
}
